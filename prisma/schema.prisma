generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

enum UserRole {
  ADMIN
  SALES
  SURVEYOR
  WAREHOUSE
  TECHNICIAN
  SUPPORT

  @@map("user_role")
}

enum ProjectStatus {
  LEAD_RECEIVED
  SURVEY
  QUOTATION
  APPROVAL
  PROCUREMENT
  DISPATCH
  INSTALLATION
  COMMISSIONING
  COMPLETED
  ON_HOLD
  CANCELLED

  @@map("project_status")
}

enum ProjectType {
  NEW_INSTALLATION
  REPLACEMENT
  RESTORATION
  STRUCTURE_REBUILD
  SYSTEM_UPGRADE
  MAINTENANCE

  @@map("project_type")
}

enum SystemType {
  ON_GRID
  OFF_GRID
  HYBRID

  @@map("system_type")
}

enum ComponentType {
  PANEL
  INVERTER
  BATTERY
  STRUCTURE
  BALANCE_OF_SYSTEM
  MISCELLANEOUS

  @@map("component_type")
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID

  @@map("warranty_status")
}

enum TicketStatus {
  OPEN
  INVESTIGATION
  WAITING_FOR_PARTS
  REPAIRING
  PARTS_REPLACED
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum SalaryType {
  MONTHLY
  DAILY
  PROJECT_BASED

  @@map("salary_type")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE

  @@map("attendance_status")
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER

  @@map("payment_method")
}

// ================= 1. USER =================

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String   @map("password_hash")
  name     String
  role     UserRole
  isActive Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  surveys SiteSurvey[]
  workers Worker[]

  @@map("users")
}

// ================= 2. BUSINESS =================

model Business {
  id      Int     @id @default(autoincrement())
  name    String
  phone   String
  email   String?
  address String
  gstin   String?
  pan     String?
  logo    String?

  @@map("business")
}

// ================= 3. CUSTOMER =================

model Customer {
  id             Int     @id @default(autoincrement())
  name           String
  phone          String  @unique
  alternatePhone String? @map("alternate_phone")
  email          String?
  address        String
  billingAddress String? @map("billing_address")
  gstin          String?
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")

  projects Project[]
  invoices Invoice[]
  payments Payment[]

  @@map("customers")
}

// ================= 4. PROJECT =================

model Project {
  id         Int    @id @default(autoincrement())
  code       String @unique
  customerId Int    @map("customer_id")

  type     ProjectType
  status   ProjectStatus @default(LEAD_RECEIVED)
  progress Int           @default(0)

  capacity   Decimal    @db.Decimal(8, 2)
  systemType SystemType @map("system_type")

  budget     Decimal? @db.Decimal(12, 2)
  actualCost Decimal  @default(0) @map("actual_cost")
  price      Decimal? @db.Decimal(12, 2)

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  notes String?

  createdAt DateTime @default(now()) @map("created_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  survey           SiteSurvey?
  progressLogs     ProjectProgress[]
  materials        ProjectMaterial[]
  workers          ProjectWorker[]
  workLogs         WorkLog[]
  dispatches       Dispatch[]
  commissioning    Commissioning?
  tickets          SupportTicket[]
  quotations       Quotation[]
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  serialRegistries SerialRegistry[]

  @@index([customerId])
  @@index([status])
  @@map("projects")
}

// ================= 5. PROJECT PROGRESS =================

model ProjectProgress {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  progress    Int
  description String?
  date        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("project_progress")
}

// ================= 6. SITE SURVEY =================

model SiteSurvey {
  id         Int @id @default(autoincrement())
  projectId  Int @unique @map("project_id")
  surveyorId Int @map("surveyor_id")

  roofArea       Decimal @map("roof_area") @db.Decimal(8, 2)
  tilt           Decimal @db.Decimal(5, 2)
  azimuth        Decimal @db.Decimal(5, 2)
  cableLength    Decimal @map("cable_length") @db.Decimal(8, 2)
  sanctionedLoad Decimal @map("sanctioned_load") @db.Decimal(8, 2)

  shadowFree Boolean @default(true) @map("shadow_free")
  viable     Boolean

  notes      String?
  surveyDate DateTime @default(now()) @map("survey_date")

  project  Project @relation(fields: [projectId], references: [id])
  surveyor User    @relation(fields: [surveyorId], references: [id])

  @@map("site_surveys")
}

// ================= 7. STOCK ITEM =================

model StockItem {
  id       Int           @id @default(autoincrement())
  sku      String        @unique
  name     String
  category ComponentType

  unit     String  @default("PCS")
  cost     Decimal @db.Decimal(12, 2)
  quantity Decimal @default(0) @db.Decimal(12, 2)
  minStock Decimal @default(0) @map("min_stock") @db.Decimal(12, 2)

  warrantyMonths Int @map("warranty_months")

  materials ProjectMaterial[]
  serials   SerialRegistry[]

  @@map("stock_items")
}

// ================= 8. PROJECT MATERIAL =================

model ProjectMaterial {
  id          Int @id @default(autoincrement())
  projectId   Int @map("project_id")
  stockItemId Int @map("stock_item_id")

  planned  Decimal @default(0) @db.Decimal(12, 2)
  used     Decimal @default(0) @db.Decimal(12, 2)
  returned Decimal @default(0) @db.Decimal(12, 2)

  unitCost  Decimal @map("unit_cost") @db.Decimal(12, 2)
  totalCost Decimal @map("total_cost") @db.Decimal(12, 2)

  project   Project   @relation(fields: [projectId], references: [id])
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([projectId, stockItemId])
  @@map("project_materials")
}

// ================= 9. SERIAL REGISTRY =================

model SerialRegistry {
  id           Int    @id @default(autoincrement())
  serialNumber String @unique @map("serial_number")
  stockItemId  Int    @map("stock_item_id")
  projectId    Int?   @map("project_id")

  dispatched    Boolean   @default(false)
  warrantyStart DateTime? @map("warranty_start") @db.Date
  warrantyEnd   DateTime? @map("warranty_end") @db.Date

  status WarrantyStatus @default(ACTIVE)

  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])

  @@map("serial_registry")
}

// ================= 10. DISPATCH =================

model Dispatch {
  id        Int    @id @default(autoincrement())
  number    String @unique
  projectId Int    @map("project_id")

  date        DateTime @default(now())
  vehicle     String?
  transporter String?
  notes       String?

  project Project @relation(fields: [projectId], references: [id])

  @@map("dispatches")
}

// ================= 11. WORKER =================

model Worker {
  id     Int  @id @default(autoincrement())
  userId Int? @unique @map("user_id")

  code        String @unique
  name        String
  phone       String @unique
  designation String

  salaryType SalaryType @default(MONTHLY) @map("salary_type")

  monthlySalary Decimal? @map("monthly_salary") @db.Decimal(12, 2)
  dailyRate     Decimal? @map("daily_rate") @db.Decimal(12, 2)
  projectRate   Decimal? @map("project_rate") @db.Decimal(12, 2)

  joiningDate DateTime @map("joining_date") @db.Date
  active      Boolean  @default(true)

  user User? @relation(fields: [userId], references: [id])

  projects             ProjectWorker[]
  attendance           Attendance[]
  workLogs             WorkLog[]
  payrollItems         PayrollItem[]
  leadCommissioning    Commissioning[]       @relation("LeadWorker")
  commissioningWorkers CommissioningWorker[]

  @@map("workers")
}

// ================= 12. PROJECT WORKERS =================

model ProjectWorker {
  id        Int @id @default(autoincrement())
  projectId Int @map("project_id")
  workerId  Int @map("worker_id")

  role String?

  project Project @relation(fields: [projectId], references: [id])
  worker  Worker  @relation(fields: [workerId], references: [id])

  @@unique([projectId, workerId])
  @@map("project_workers")
}

// ================= 13. ATTENDANCE =================

model Attendance {
  id       Int      @id @default(autoincrement())
  workerId Int      @map("worker_id")
  date     DateTime @db.Date

  status   AttendanceStatus @default(PRESENT)
  checkIn  DateTime?        @map("check_in")
  checkOut DateTime?        @map("check_out")

  worker Worker @relation(fields: [workerId], references: [id])

  @@unique([workerId, date])
  @@map("attendance")
}

// ================= 14. WORK LOG =================

model WorkLog {
  id        Int @id @default(autoincrement())
  workerId  Int @map("worker_id")
  projectId Int @map("project_id")

  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(5, 2)
  overtime    Decimal  @default(0) @db.Decimal(5, 2)
  description String?

  worker  Worker  @relation(fields: [workerId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@index([workerId, date])
  @@map("work_logs")
}

// ================= 15. PAYROLL =================

model Payroll {
  id    Int     @id @default(autoincrement())
  month Int
  year  Int
  total Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  items PayrollItem[]

  @@unique([month, year])
  @@map("payroll")
}

model PayrollItem {
  id        Int @id @default(autoincrement())
  payrollId Int @map("payroll_id")
  workerId  Int @map("worker_id")

  basicSalary Decimal @default(0) @map("basic_salary") @db.Decimal(12, 2)
  overtime    Decimal @default(0) @db.Decimal(12, 2)
  allowance   Decimal @default(0) @db.Decimal(12, 2)
  deduction   Decimal @default(0) @db.Decimal(12, 2)

  netSalary  Decimal @default(0) @map("net_salary") @db.Decimal(12, 2)
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(12, 2)

  payroll Payroll @relation(fields: [payrollId], references: [id])
  worker  Worker  @relation(fields: [workerId], references: [id])

  @@unique([payrollId, workerId])
  @@map("payroll_items")
}

// ================= 16. COMMISSIONING =================

model Commissioning {
  id           Int @id @default(autoincrement())
  projectId    Int @unique @map("project_id")
  leadWorkerId Int @map("lead_worker_id")

  voc      Decimal @db.Decimal(8, 2)
  isc      Decimal @db.Decimal(8, 2)
  earthing Decimal @db.Decimal(8, 2)

  photo     String?
  signature String?
  signedAt  DateTime?

  notes String?

  project    Project @relation(fields: [projectId], references: [id])
  leadWorker Worker  @relation("LeadWorker", fields: [leadWorkerId], references: [id])

  workers CommissioningWorker[]

  @@map("commissioning")
}

model CommissioningWorker {
  id              Int @id @default(autoincrement())
  commissioningId Int @map("commissioning_id")
  workerId        Int @map("worker_id")

  commissioning Commissioning @relation(fields: [commissioningId], references: [id])
  worker        Worker        @relation(fields: [workerId], references: [id])

  @@unique([commissioningId, workerId])
  @@map("commissioning_workers")
}

// ================= 17. SUPPORT TICKETS =================

model SupportTicket {
  id        Int    @id @default(autoincrement())
  number    String @unique
  projectId Int    @map("project_id")

  serialNumber String? @map("serial_number")
  fault        String
  description  String

  status TicketStatus @default(OPEN)

  warrantyCovered Boolean @default(false) @map("warranty_covered")
  amount          Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  project Project        @relation(fields: [projectId], references: [id])
  updates TicketUpdate[]

  @@map("support_tickets")
}

model TicketUpdate {
  id          Int          @id @default(autoincrement())
  ticketId    Int          @map("ticket_id")
  status      TicketStatus
  description String
  date        DateTime     @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@map("ticket_updates")
}

// ================= 18. QUOTATIONS =================

model Quotation {
  id        Int    @id @default(autoincrement())
  number    String @unique
  projectId Int    @map("project_id")

  amount   Decimal @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  date DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@map("quotations")
}

// ================= 19. INVOICES =================

model Invoice {
  id         Int    @id @default(autoincrement())
  number     String @unique
  customerId Int    @map("customer_id")
  projectId  Int    @map("project_id")

  amount Decimal  @db.Decimal(12, 2)
  tax    Decimal  @default(0) @db.Decimal(12, 2)
  total  Decimal  @db.Decimal(12, 2)
  date   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])

  payments Payment[]

  @@map("invoices")
}

// ================= 20. CUSTOMER PAYMENTS =================

model Payment {
  id         Int @id @default(autoincrement())
  customerId Int @map("customer_id")
  projectId  Int @map("project_id")
  invoiceId  Int @map("invoice_id")

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod
  date   DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

// ================= 21. BUSINESS EXPENSES =================

model Expense {
  id        Int  @id @default(autoincrement())
  projectId Int? @map("project_id")

  category    String
  description String
  amount      Decimal @db.Decimal(12, 2)

  date    DateTime @default(now())
  receipt String?

  project Project? @relation(fields: [projectId], references: [id])

  @@map("expenses")
}
