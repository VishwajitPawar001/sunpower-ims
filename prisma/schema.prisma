datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS: ROLES, SYSTEMS, LOGISTICS & LIFECYCLE
// ----------------------------------------------------

enum UserRole {
  DIRECTOR
  ADMIN
  SALES
  SURVEYOR
  WAREHOUSE
  LEAD_TECHNICIAN
  FIELD_RIGGER
  SUPPORT
}

enum SystemType {
  ON_GRID
  OFF_GRID
  HYBRID
}

enum RoofType {
  FLAT_RCC
  METAL_SHEET
  TILED
  GROUND_MOUNT
}

enum ProjectStatus {
  LEAD_RECEIVED
  SURVEY_SCHEDULED
  SURVEY_APPROVED
  QUOTE_ACCEPTED
  DISPATCH_PENDING
  DISPATCHED
  INSTALLATION_IN_PROGRESS
  COMMISSIONED
  DISCOM_SYNCED
  CANCELLED
}

enum ComponentCategory {
  PANEL
  INVERTER
  BATTERY
  CHARGE_CONTROLLER
  STRUCTURE
  BALANCE_OF_SYSTEM
  SAFETY_EARTHING
}

enum SerialStatus {
  IN_STOCK
  DISPATCHED
  INSTALLED
  FAILED_RMA
  RETURNED_TO_VENDOR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BillingType {
  WARRANTY_FREE
  BILLABLE
}

// ----------------------------------------------------
// 1. PEOPLE & STAFF MANAGEMENT (ZERO UUIDs)
// ----------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  employeeCode String   @unique // EMP-001, EMP-002, etc.
  email        String   @unique
  fullName     String
  phone        String?
  role         UserRole
  monthlySalary Decimal @default(0.00) @db.Decimal(10, 2)
  dailyLaborRate Decimal @default(0.00) @db.Decimal(10, 2) // For project cost booking
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedSurveys       SiteSurvey[]
  assignedInstallations InstallationRecord[]
  supportTickets        SupportTicket[]
}

// ----------------------------------------------------
// 2. CUSTOMER DIRECTORY (INDEXED BY PHONE)
// ----------------------------------------------------

model Customer {
  id                  Int      @id @default(autoincrement())
  customerCode        String   @unique // CUST-00001
  fullName            String
  phone               String   @unique // Primary unique search index
  email               String?
  installationAddress String
  city                String
  state               String
  pincode             String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  projects       Project[]
  supportTickets SupportTicket[]
}

// ----------------------------------------------------
// 3. READY-MADE SYSTEM TEMPLATES (1kW - 5kW PACKAGES)
// ----------------------------------------------------

model PackageTemplate {
  id               Int        @id @default(autoincrement())
  packageCode      String     @unique // e.g., PKG-ONGRID-3KW, PKG-OFFGRID-5KW, PKG-HYBRID-5KW
  name             String
  capacityKw       Decimal    @db.Decimal(4, 2)
  systemType       SystemType
  panelCount       Int
  inverterRatingKw Decimal    @db.Decimal(4, 2)
  batteryCapacityAh Int?      // Applicable for OFF_GRID and HYBRID
  baseHardwareCost Decimal    @db.Decimal(10, 2)
  baseLaborCost    Decimal    @db.Decimal(10, 2)
  defaultPrice     Decimal    @db.Decimal(10, 2)
  isActive         Boolean    @default(true)

  projects Project[]
}

// ----------------------------------------------------
// 4. MASTER PROJECT LIFECYCLE
// ----------------------------------------------------

model Project {
  id                Int           @id @default(autoincrement())
  projectCode       String        @unique // PRJ-YYYY-##### (e.g., PRJ-2026-00042)
  customerId        Int
  packageTemplateId Int?
  systemCapacityKw  Decimal       @db.Decimal(4, 2)
  systemType        SystemType    @default(ON_GRID)
  status            ProjectStatus @default(LEAD_RECEIVED)

  // Phase 1 Baseline Intake Data
  consumerAccountNumber String?
  sanctionedLoadKw      Decimal?  @db.Decimal(5, 2)
  monthlyPowerBill      Decimal?  @db.Decimal(10, 2)

  // Phase 2 Financials & Milestone Payment Gates
  totalQuotedPrice      Decimal   @db.Decimal(10, 2)
  bookingAdvancePaid    Decimal   @default(0.00) @db.Decimal(10, 2) // 20% Milestone
  dispatchPaymentPaid   Decimal   @default(0.00) @db.Decimal(10, 2) // 70% Milestone Gate
  finalBalancePaid      Decimal   @default(0.00) @db.Decimal(10, 2) // 10% Milestone

  // Phase 2 Direct Project Cost Tracking (Director Margin Analysis)
  freightCost           Decimal   @default(0.00) @db.Decimal(10, 2)
  civilMaterialCost     Decimal   @default(0.00) @db.Decimal(10, 2)
  directLaborCost       Decimal   @default(0.00) @db.Decimal(10, 2)

  // Phase 7 DISCOM Net-Metering & Grid Handover
  discomApplicationNumber  String?
  bidirectionalMeterSerial String?
  isGridSynchronized        Boolean   @default(false)
  gridSyncDate              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer            Customer             @relation(fields: [customerId], references: [id])
  packageTemplate     PackageTemplate?     @relation(fields: [packageTemplateId], references: [id])
  siteSurvey          SiteSurvey?
  dispatchedSerials   SerialRegistry[]
  installationRecord  InstallationRecord[]
  supportTickets      SupportTicket[]
}

// ----------------------------------------------------
// 5. PHASE 1: SITE AUDIT & FEASIBILITY SURVEY
// ----------------------------------------------------

model SiteSurvey {
  id              Int      @id @default(autoincrement())
  projectId       Int      @unique
  surveyorId      Int
  roofType        RoofType @default(FLAT_RCC)
  usableAreaSqFt  Decimal  @db.Decimal(8, 2) // Minimum 100 sq ft per kW
  isSouthFacing   Boolean  @default(true)
  tiltAngleDeg    Decimal  @db.Decimal(4, 1) // 18 - 22 degrees
  hasShadingIssue Boolean  @default(false)
  parapetHeightFt Decimal  @default(0.0) @db.Decimal(4, 1)
  dcCableRunMtrs  Decimal  @db.Decimal(6, 2)
  acCableRunMtrs  Decimal  @db.Decimal(6, 2)
  earthPitViable  Boolean  @default(true)   // Ground space for 3 chemical pits
  isApproved      Boolean  @default(false)  // Mandatory gate before quote
  rejectionReason String?
  surveyNotes     String?
  surveyDate      DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id])
  surveyor User    @relation(fields: [surveyorId], references: [id])
}

// ----------------------------------------------------
// 6. PHASE 3: WAREHOUSE STOCK & SKUs
// ----------------------------------------------------

model StockItem {
  id             Int               @id @default(autoincrement())
  sku            String            @unique // SKU-PNL-550W, SKU-INV-5KW, SKU-BAT-100AH
  modelName      String
  category       ComponentCategory
  unitCost       Decimal           @db.Decimal(10, 2)
  quantityOnHand Int               @default(0)
  warrantyMonths Int               @default(24) // 24 mos inverter/battery, 240 mos panels

  serials SerialRegistry[]
}

// ----------------------------------------------------
// 7. PHASE 3 & 4: SERIAL REGISTRY & BARCODE TRACKING
// ----------------------------------------------------

model SerialRegistry {
  id              Int          @id @default(autoincrement())
  serialNumber    String       @unique // Direct manufacturer barcode
  stockItemId     Int
  projectId       Int?
  status          SerialStatus @default(IN_STOCK)
  isDispatched    Boolean      @default(false)
  warrantyEndDate DateTime?
  dispatchedAt    DateTime?

  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])
}

// ----------------------------------------------------
// 8. PHASE 5 & 6: FIELD INSTALLATION MINI-LIFECYCLE
// ----------------------------------------------------

model InstallationRecord {
  id                     Int       @id @default(autoincrement())
  projectId              Int       @unique
  leadTechnicianId       Int

  // Sub-Lifecycle Gate Checkpoints
  transitReceivedAt      DateTime  @default(now())
  civilPadsCompleted     Boolean   @default(false)
  groutCuringVerified    Boolean   @default(false) // 24hr curing gate
  structureTorqued       Boolean   @default(false)
  dcConduitCompleted     Boolean   @default(false)
  earthPitsCompleted     Boolean   @default(false) // 3 chemical earth pits

  // Phase 6 Pre-Power Safety Audit
  vocVolts               Decimal   @db.Decimal(6, 2)
  iscAmperes             Decimal   @db.Decimal(6, 2)
  earthResistanceOhms    Decimal   @db.Decimal(5, 2) // Must be < 5.0 ohms
  roofPhotoUrl           String?
  customerSignatureSvg   String    @db.Text
  installedAt            DateTime  @default(now())

  project        Project @relation(fields: [projectId], references: [id])
  leadTechnician User    @relation(fields: [leadTechnicianId], references: [id])
}

// ----------------------------------------------------
// 9. PHASE 8: TICKETS, SERVICE & RMA REPLACEMENTS
// ----------------------------------------------------

model SupportTicket {
  id                 Int          @id @default(autoincrement())
  ticketCode         String       @unique // TCK-#####
  projectId          Int
  customerId         Int
  assignedToId       Int?
  status             TicketStatus @default(OPEN)
  billingType        BillingType  @default(WARRANTY_FREE)
  reportedIssue      String
  faultySerialNumber String?      // Defective unit (e.g. blown inverter)
  replacedWithSerial String?      // Replacement serial swapped from stock
  resolutionNotes    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  project    Project  @relation(fields: [projectId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  assignedTo User?    @relation(fields: [assignedToId], references: [id])
}